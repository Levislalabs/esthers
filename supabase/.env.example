# =========================================================================
# Local Edge Function environment - EXAMPLE. Placeholders only.
#
#   cp supabase/.env.example supabase/.env
#   then fill in the real values
#
# supabase/.env is gitignored. Never commit the real file.
#
# In a DEPLOYED function, SUPABASE_URL and the key variables are injected
# by Supabase automatically - you do not set them by hand. This file exists
# only for `supabase functions serve` on your own machine.
# =========================================================================

# Project URL. Local: http://127.0.0.1:54321
SUPABASE_URL=PASTE_PROJECT_URL_HERE

# Browser-safe key. Used only to verify a staff member's JWT.
SUPABASE_PUBLISHABLE_KEY=PASTE_sb_publishable_KEY_HERE

# ---------------------------------------------------------------------
# SECRET. Full database access, bypasses every Row Level Security policy.
#
# This value belongs in exactly two places: this local file, and the
# Supabase dashboard. It must NEVER appear in index.html, in any file
# under assets/, in staff/config.js, in a commit, in a log line, in an
# error message, or in a bundled artifact.
#
# If it is ever exposed, rotate it in the dashboard immediately. Deleting
# the file or the commit afterwards does not undo the exposure.
# ---------------------------------------------------------------------
SUPABASE_SECRET_KEY=PASTE_sb_secret_KEY_HERE

# Optional. Extra allowed browser origins, comma separated, exact origins.
# The built-in list is in supabase/functions/_shared/cors.ts
# CHAT_ALLOWED_ORIGINS=https://esthers.ca,https://www.esthers.ca
