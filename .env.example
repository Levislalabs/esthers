# -------------------------------------------------------------------------
# Environment variables this site expects.
#
# NAMES AND PLACEHOLDERS ONLY. Every value below is fake. Nothing real
# belongs in this file, it is committed to Git and anything written here is
# published the moment it is pushed.
#
# The real values are set in the Vercel dashboard, under
#   Project -> Settings -> Environment Variables
# and are never read from a file in this repository.
#
# IF A REAL FIREBASE PRIVATE KEY IS EVER COMMITTED, IT IS COMPROMISED.
# Rotate the service account in the Firebase console immediately. Deleting
# the file, amending the commit or rewriting history does NOT undo it - the
# key was published the moment it was pushed.
# -------------------------------------------------------------------------


# =========================================================================
# QUOTE REQUEST FORM - already configured in production
# =========================================================================

# Resend API key, used to send the quote-request email.
RESEND_API_KEY=re_placeholder_not_a_real_key

# The addresses the quote email is sent from and to.
QUOTE_FROM=quotes@example.invalid
QUOTE_TO=office@example.invalid

# Vercel Blob read/write token, used for direct client-to-storage uploads
# of quote attachments. Provided automatically when a Blob store is linked.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder


# =========================================================================
# FIREBASE CHAT - NOT YET CONFIGURED IN PRODUCTION
#
# The chat API refuses to run without all four of these. A deployment
# missing any of them answers 503 rather than starting up half-working;
# that is deliberate, and is tested.
#
# The three FIREBASE_* values come from a service account created in the
# Firebase console (Project settings -> Service accounts -> Generate new
# private key). THE DOWNLOADED JSON FILE MUST NOT BE ADDED TO THIS
# REPOSITORY. Copy the three fields out of it into the Vercel dashboard and
# then delete the file.
# =========================================================================

# Must be exactly the project id the chat code was written for. The Admin
# SDK bypasses Firestore Security Rules completely, so a wrong value here
# is not caught by any rule - it would simply write to the wrong project.
# api/_chat/firebase-admin.js refuses to start unless this matches the
# project id it holds as a constant.
FIREBASE_PROJECT_ID=your-firebase-project-id

# The service account's client_email field, verbatim.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# The service account's private_key field, verbatim.
#
# Paste it exactly as it appears in the JSON, including the \n escapes and
# the surrounding quotes - the code normalises both. The value below is a
# placeholder, not a key.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER_NOT_A_REAL_KEY\n-----END PRIVATE KEY-----\n"

# A random secret used to HMAC rate-limit identifiers before they are
# stored, so no raw IP address is ever written to Firestore. It is not a
# Firebase value and is not shared with anyone: generate one and paste it.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Must be at least 16 characters. Mutating chat routes refuse to run
# without it rather than running unlimited.
CHAT_RATE_LIMIT_SECRET=generate_a_long_random_value_at_least_16_chars
